apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

resources:
  - ../../storage/moodle-storage.yaml
  - ../../mysql/secret.yaml      # <--- Added MySQL secret file
  - ../../mysql/deployment.yaml
  - ../../mysql/service.yaml
  - ../../php/secret.yaml        # <--- Added PHP secret file
  - ../../php/deployment.yaml
  - ../../php/service.yaml
  - ../../nginx/configmap.yaml
  - ../../nginx/deployment.yaml
  - ../../nginx/secret.yaml        # <--- Added PHP secret file
  - ../../nginx/service.yaml
  - ./ingress.yaml

images:
  - name: extn-php:8.2
    newName: northamerica-northeast2-docker.pkg.dev/civic-champion-439320-a5/moodle-repo/custom-php
    newTag: "8.2"
